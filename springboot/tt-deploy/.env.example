# 复制为 .env 后填写密钥，或直接运行 ./up.sh（会自动生成随机密钥）
# 切勿把填好的 .env 提交到 Git

# 必填：数据库 root 密码（不要使用仓库或文档里出现过的示例口令）
MYSQL_ROOT_PASSWORD=

# 必填：JWT 签名密钥（至少 32 字符随机串；泄露即可伪造管理员身份）
TT_JWT_SECRET=

# 宿主机端口（冲突时改这些）
WEB_HOST_PORT=8080
# Web 监听地址：本机调试可用 127.0.0.1；局域网/公网演示用 0.0.0.0（并配合防火墙）
WEB_BIND_ADDRESS=0.0.0.0
# 以下端口仅绑定 127.0.0.1，不会对公网开放
BACKEND_HOST_PORT=8088
MYSQL_HOST_PORT=3309
