{
  "info": {
    "name": "国家电网数据平台 State-Grid",
    "description": "对应 springboot/State-Grid。\n\n导入方式（Apifox 一键导入）：\n1. 打开 Apifox -> 项目设置/导入 -> 导入 Postman Collection 和 Environment\n2. 选择本目录 state-grid.postman_collection.json\n3. 再导入 state-grid.postman_environment.json\n4. 先启动 docker/up.sh，再启动 blade-mock、state-grid-app\n5. 建议按文件夹顺序执行：01 拿 Token -> 02 同步台账 -> 03 导出报告\n\n账号说明：OAuth 密码是 admin 的 MD5（21232f297a57a5a743894a0e4a801fc3）",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "mockUrl", "value": "http://localhost:18080" },
    { "key": "date", "value": "2026-09-04" },
    { "key": "tenantId", "value": "000000" },
    { "key": "username", "value": "admin" },
    { "key": "password", "value": "21232f297a57a5a743894a0e4a801fc3" },
    { "key": "bladeAuth", "value": "" }
  ],
  "item": [
    {
      "name": "01-获取Token（试卷接口）",
      "item": [
        {
          "name": "GET /auth/token 返回远程 Token",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/auth/token",
              "host": ["{{baseUrl}}"],
              "path": ["auth", "token"]
            },
            "description": "读取 yml 中的租户/账号/client，调用远程 OAuth，返回 accessToken。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回 accessToken', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.accessToken).to.be.a('string').and.not.empty;",
                  "});",
                  "pm.collectionVariables.set('accessToken', json.data.accessToken);"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "02-台账同步（调试）",
      "item": [
        {
          "name": "POST /job/sync 立即同步一次",
          "request": {
            "method": "POST",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/job/sync",
              "host": ["{{baseUrl}}"],
              "path": ["job", "sync"]
            },
            "description": "试卷要求启动时跑一次、每天 03:00 再跑。本接口方便立刻验证增量同步、Excel、MinIO。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "const json = pm.response.json();",
                  "pm.test('返回同步统计', function () {",
                  "    pm.expect(json.success).to.eql(true);",
                  "    pm.expect(json.data.totalCount).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /report/stat 查看某日统计",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/report/stat?date={{date}}",
              "host": ["{{baseUrl}}"],
              "path": ["report", "stat"],
              "query": [{ "key": "date", "value": "{{date}}" }]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('含新增/删除计数', function () {",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data).to.have.property('newCount');",
                  "    pm.expect(json.data).to.have.property('deletedCount');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "03-日报Word导出（试卷接口）",
      "item": [
        {
          "name": "GET /report/export 导出 Word",
          "request": {
            "method": "GET",
            "header": [],
            "url": {
              "raw": "{{baseUrl}}/report/export?date={{date}}",
              "host": ["{{baseUrl}}"],
              "path": ["report", "export"],
              "query": [{ "key": "date", "value": "{{date}}" }]
            },
            "description": "返回 docx。Apifox 右上角可另存为文件。把环境变量 date 改成当天。"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', function () { pm.response.to.have.status(200); });",
                  "pm.test('是 Word 附件', function () {",
                  "    const cd = pm.response.headers.get('Content-Disposition') || '';",
                  "    const ct = pm.response.headers.get('Content-Type') || '';",
                  "    pm.expect(cd.toLowerCase()).to.include('attachment');",
                  "    pm.expect(ct).to.include('wordprocessingml');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "04-监控",
      "item": [
        {
          "name": "健康检查 /actuator/health",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/health",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "health"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('应用 UP', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.json().status).to.eql('UP');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Prometheus 指标 /actuator/prometheus",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/actuator/prometheus",
              "host": ["{{baseUrl}}"],
              "path": ["actuator", "prometheus"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('暴露 prometheus 文本', function () {",
                  "    pm.response.to.have.status(200);",
                  "    pm.expect(pm.response.text()).to.include('jvm_memory');",
                  "});"
                ]
              }
            }
          ]
        }
      ]
    },
    {
      "name": "05-模拟第三方Blade（直连 mock）",
      "item": [
        {
          "name": "POST /blade-auth/token 远程OAuth",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Basic c2FiZXI6c2FiZXJfc2VjcmV0" },
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "url": {
              "raw": "{{mockUrl}}/blade-auth/token?tenantId={{tenantId}}&username={{username}}&password={{password}}&grant_type=password&type=account&scope=all",
              "host": ["{{mockUrl}}"],
              "path": ["blade-auth", "token"],
              "query": [
                { "key": "tenantId", "value": "{{tenantId}}" },
                { "key": "username", "value": "{{username}}" },
                { "key": "password", "value": "{{password}}" },
                { "key": "grant_type", "value": "password" },
                { "key": "type", "value": "account" },
                { "key": "scope", "value": "all" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('OAuth 成功', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.accessToken).to.be.ok;",
                  "    pm.collectionVariables.set('bladeAuth', json.data.accessToken);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "GET /blade-user/user-list 用户台账",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Basic c2FiZXI6c2FiZXJfc2VjcmV0" },
              { "key": "Content-Type", "value": "application/json;charset=UTF-8" },
              { "key": "Blade-Auth", "value": "{{bladeAuth}}" }
            ],
            "url": {
              "raw": "{{mockUrl}}/blade-user/user-list?current=1&size=10",
              "host": ["{{mockUrl}}"],
              "path": ["blade-user", "user-list"],
              "query": [
                { "key": "current", "value": "1" },
                { "key": "size", "value": "10" }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('返回分页 records', function () {",
                  "    pm.response.to.have.status(200);",
                  "    const json = pm.response.json();",
                  "    pm.expect(json.data.records.length).to.be.at.least(1);",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "POST /blade-user/mock/add 新增模拟用户（测增量）",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/x-www-form-urlencoded" }
            ],
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                { "key": "account", "value": "newuser01" },
                { "key": "name", "value": "新员工" }
              ]
            },
            "url": {
              "raw": "{{mockUrl}}/blade-user/mock/add",
              "host": ["{{mockUrl}}"],
              "path": ["blade-user", "mock", "add"]
            }
          }
        },
        {
          "name": "POST /blade-user/mock/delete/10002 逻辑删除（测删除统计）",
          "request": {
            "method": "POST",
            "url": {
              "raw": "{{mockUrl}}/blade-user/mock/delete/10002",
              "host": ["{{mockUrl}}"],
              "path": ["blade-user", "mock", "delete", "10002"]
            }
          }
        }
      ]
    }
  ]
}
