<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.mybatis.mapper.PassportMapper">

    <resultMap id="passportAndPassengerMap" type="Passport">
        <id property="id" column="id"/>
        <result property="nationality" column="nationality"/>
        <result property="expire" column="expire"/>
        <result property="passengerId" column="passenger_id"/>
        <association property="passenger" select="com.springboot.mybatis.mapper.PassengerMapper.selectPassengerBaseById"
                     column="passenger_id" javaType="Passenger"/>
    </resultMap>


    <select id="selectPassportById" resultMap="passportAndPassengerMap">
        select * from t_passports where id = #{id}
    </select>


    <resultMap id="passportAndPassengerMap2" type="Passport">
        <id property="id" column="passport_id"/>
        <result property="nationality" column="nationality"/>
        <result property="expire" column="expire"/>
        <result property="passengerId" column="passenger_id"/>
        <association property="passenger" javaType="Passenger">
            <id property="id" column="passenger_id"/>
            <result property="name" column="passenger_name"/>
            <result property="sex" column="sex"/>
            <result property="birthday" column="birthday"/>
        </association>
    </resultMap>

    <select id="selectPassportById2" resultMap="passportAndPassengerMap2">
        select pp.id as passport_id,
               pp.nationality as nationality,
               pp.expire as expire,
               pe.id as passenger_id,
               pe.name as passenger_name,
               pe.sex as sex,
               pe.birthday as birthday
        from t_passports pp left join t_passengers pe on pp.passenger_id = pe.id
        where pp.id = #{id};
    </select>
</mapper>