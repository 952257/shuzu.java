<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.springboot.mybatis.mapper.StudentMapper">

   <resultMap id="StudentAndSubjectMap" type="Student">
      <id property="id" column="id"/>
      <result property="name" column="name"/>
      <result property="sex" column="sex"/>
      <collection property="subjects" ofType="Subject"
      select="com.springboot.mybatis.mapper.SubjectMapper.selectSubjectByStudentId"
                  column="id"
      />
   </resultMap>

   <select id="selectAllStudents" resultMap="StudentAndSubjectMap">
      select * from t_student;
   </select>

   <resultMap id="StudentAndSubjectMap2" type="Student">
      <id property="id" column="stu_id"/>
      <result property="name" column="stu_name"/>
      <result property="sex" column="stu_sex"/>
      <collection property="subjects" ofType="Subject">
         <id property="id" column="sub_id"/>
         <result property="name" column="sub_name"/>
         <result property="grade" column="sub_grade"/>
      </collection>
   </resultMap>

   <select id="selectAllStudents2" resultMap="StudentAndSubjectMap2">
      select stu.id as stu_id,stu.name as stu_name,
             stu.sex as stu_sex,sub.id as sub_id,
             sub.name as sub_name,sub.grade as sub_grade
      from t_student stu left join t_stu_sub ss on stu.id = ss.student_id
                         left join t_subject sub on sub.id = ss.subject_id
   </select>
</mapper>